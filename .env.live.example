# Copy this file to .env.live, then edit it. Never commit .env.live.
# This hostname must resolve to the server running Docker and allow inbound TCP 80/443.
WANXIANG_DOMAIN=api.example.com

# Required. Generate with: openssl rand -hex 32
WANXIANG_API_TOKEN=

# The browser origin is checked exactly. Add other trusted frontends explicitly.
WANXIANG_CORS_ORIGIN=https://daohan003.github.io

# Server-managed simulation cadence. Set 0 for manual stepping.
WANXIANG_TICK_MS=1000

# First boot only: defaults to a neutral, genre-independent world.
# Supported: custom, xianxia, historical, scifi, urban, western.
WANXIANG_WORLD_TYPE=custom
WANXIANG_WORLD_SEED=42

# Optional authored scenario preset; currently available: shitian.
# A preset takes precedence over WANXIANG_WORLD_TYPE when a new world is created.
WANXIANG_WORLD_PRESET=

# Optional server-side OpenAI-compatible provider configuration.
# Keep API keys out of site/index.html and all browser code.
WANXIANG_LLM_ENDPOINT=
WANXIANG_LLM_MODEL=
WANXIANG_LLM_API_KEY=
WANXIANG_LLM_TIMEOUT_MS=30000
WANXIANG_AGENT_RETRIEVAL=causal
