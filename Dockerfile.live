# Build the Rust live API without adding a runtime web framework.
FROM rust:bookworm AS builder
WORKDIR /src
COPY . .
RUN cargo build --locked --release -p wanxiang_agent_bridge --example live_server

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 wanxiang \
    && useradd --uid 10001 --gid wanxiang --home-dir /home/wanxiang --create-home --shell /usr/sbin/nologin wanxiang
WORKDIR /app
RUN mkdir -p /app/.wanxiang-live-data \
    && chown -R 10001:10001 /app
COPY --from=builder --chown=10001:10001 /src/target/release/examples/live_server /usr/local/bin/wanxiang-live
ENV WANXIANG_BIND=0.0.0.0:8787
EXPOSE 8787
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/wanxiang-live"]
