# Build the Rust live API without adding a runtime web framework.
FROM rust:bookworm AS builder
WORKDIR /src
COPY . .
RUN cargo build --locked --release -p wanxiang_agent_bridge --example live_server

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /src/target/release/examples/live_server /usr/local/bin/wanxiang-live
ENV WANXIANG_BIND=0.0.0.0:8787
EXPOSE 8787
ENTRYPOINT ["/usr/local/bin/wanxiang-live"]
